---
const year = new Date().getFullYear();
---

<footer class="bg-boudoir-ink text-boudoir-white">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="text-lg font-semibold">Boudoir Photography Auckland</p>
        <p class="mt-3 max-w-xs text-sm text-white/70">
          A private boudoir photography experience for women who want to feel
          confident and beautiful. Based on Auckland's Hibiscus Coast.
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/50">Explore</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/boudoir-photoshoot-gallery-auckland" class="hover:text-boudoir-pink">Boudoir Gallery</a></li>
          <li><a href="/maternity-photography" class="hover:text-boudoir-pink">Maternity Photography</a></li>
          <li><a href="/pricing" class="hover:text-boudoir-pink">Pricing</a></li>
          <li><a href="/faqs" class="hover:text-boudoir-pink">FAQs</a></li>
          <li><a href="/about-belinda-dunne" class="hover:text-boudoir-pink">About</a></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/50">Get in touch</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="tel:+64274326504" class="hover:text-boudoir-pink">0274 326 504</a></li>
          <li><a href="/contact-boudoir-photography-auckland" class="hover:text-boudoir-pink">Contact form</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-white/50 md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} Boudoir Photography Auckland. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="/terms-and-conditions" class="hover:text-boudoir-pink">Terms &amp; Conditions</a>
        <a href="/privacy-policy" class="hover:text-boudoir-pink">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
