---
const year = new Date().getFullYear();

const links = [
  { href: "/", label: "Boudoir" },
  { href: "/about-belinda-dunne", label: "About" },
  { href: "/pricing", label: "Pricing" },
  { href: "/contact-boudoir-photography-auckland", label: "Contact" },
  { href: "/faqs", label: "FAQs" },
  { href: "/terms-and-conditions", label: "Terms & Conditions" },
  { href: "/privacy-policy", label: "Privacy Policy" },
];
---

<footer class="bg-boudoir-white text-boudoir-ink">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-8 px-6 py-14 md:flex-row md:items-start">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <div class="flex gap-2">
        <a
          href="https://www.instagram.com/boudoirphotographyauckland/"
          aria-label="Instagram"
          class="flex h-8 w-8 items-center justify-center bg-boudoir-pink text-boudoir-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
            <path d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2zm0 1.6c-3.15 0-3.5.01-4.73.07-.96.04-1.48.2-1.83.34-.46.18-.79.39-1.13.74-.35.34-.56.67-.74 1.13-.14.35-.3.87-.34 1.83-.06 1.23-.07 1.58-.07 4.73s.01 3.5.07 4.73c.04.96.2 1.48.34 1.83.18.46.39.79.74 1.13.34.35.67.56 1.13.74.35.14.87.3 1.83.34 1.23.06 1.58.07 4.73.07s3.5-.01 4.73-.07c.96-.04 1.48-.2 1.83-.34.46-.18.79-.39 1.13-.74.35-.34.56-.67.74-1.13.14-.35.3-.87.34-1.83.06-1.23.07-1.58.07-4.73s-.01-3.5-.07-4.73c-.04-.96-.2-1.48-.34-1.83a3.03 3.03 0 0 0-.74-1.13 3.03 3.03 0 0 0-1.13-.74c-.35-.14-.87-.3-1.83-.34-1.23-.06-1.58-.07-4.73-.07zm0 4.05a5.15 5.15 0 1 1 0 10.3 5.15 5.15 0 0 1 0-10.3zm0 1.6a3.55 3.55 0 1 0 0 7.1 3.55 3.55 0 0 0 0-7.1zm5.35-1.78a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/>
          </svg>
        </a>
        <a
          href="https://www.facebook.com/boudoirphotographyauckland"
          aria-label="Facebook"
          class="flex h-8 w-8 items-center justify-center bg-boudoir-pink text-boudoir-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
            <path d="M13.5 21v-7.4h2.5l.4-2.9h-2.9V8.8c0-.85.24-1.43 1.46-1.43h1.55V4.77C16.2 4.7 15.3 4.6 14.24 4.6c-2.2 0-3.7 1.34-3.7 3.8v2.3H8v2.9h2.54V21h2.96z"/>
          </svg>
        </a>
      </div>
      <p class="text-sm text-boudoir-ink/70">
        Copyright &copy; Boudoir Photography Auckland {year}
      </p>
    </div>

    <img src="/images/boudoir-logo.png" alt="Boudoir Photography Auckland" class="h-14 w-auto" />

    <nav class="flex flex-col items-center gap-2 text-sm md:items-end">
      {links.map((link) => (
        <a href={link.href} class="text-boudoir-pink underline hover:opacity-80">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
