---
import Base from "../../layouts/Base.astro";

// Blog index. Started 2026-10-01 with one article.
// To add an article: create src/pages/blog/<slug>.astro, then add it to the
// TOP of this list (newest first) and to public/llms.txt.
const posts = [
  {
    href: "/blog/how-to-choose-a-boudoir-photographer-nz/",
    title: "How to Choose a Boudoir Photographer in New Zealand",
    date: "2026-10-01",
    dateLabel: "1 October 2026",
    excerpt:
      "Eight questions to ask before you book a boudoir shoot, from privacy and posing to reviews and pricing.",
    image: "/images/gallery/studio-bw.jpg",
    imageAlt: "Black and white studio boudoir portrait",
    pos: "50% 15%",
  },
  {
    href: "/blog/first-boudoir-shoot-what-to-expect/",
    title: "Your First Boudoir Shoot: What to Expect",
    date: "2026-10-01",
    dateLabel: "1 October 2026",
    excerpt:
      "Nervous about your first boudoir shoot? What happens before the day, when you arrive, while we shoot and after, at a private session in Auckland.",
    image: "/images/gallery/curvy-soft-light.jpg",
    imageAlt: "Boudoir portrait of a woman in white lace leaning against a wall in soft window light",
    pos: "50% 20%",
  },
];
---

<Base
  title="Boudoir Photography Blog | Boudoir Photography Auckland"
  description="Guides and answers for women thinking about a boudoir shoot in Auckland, from Hibiscus Coast photographer Belinda Dunne."
>
  <section class="mx-auto max-w-3xl px-6 pt-16 text-center">
    <h1 class="text-4xl text-boudoir-ink md:text-5xl">Blog</h1>
    <p class="mt-6 text-boudoir-muted">
      Answers to the questions women ask me before a boudoir shoot, written out
      in full so you can read them in your own time.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="grid gap-10 md:grid-cols-2">
      {posts.map((p) => (
        <a href={p.href} class="group block">
          <img
            src={p.image}
            alt={p.imageAlt}
            loading="lazy"
            class="h-72 w-full object-cover"
            style={`object-position: ${p.pos}`}
          />
          <p class="mt-5 text-sm uppercase tracking-wide text-boudoir-pink">
            <time datetime={p.date}>{p.dateLabel}</time>
          </p>
          <h2 class="mt-2 text-2xl text-boudoir-ink group-hover:text-boudoir-red">{p.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-boudoir-muted">{p.excerpt}</p>
          <p class="mt-3 text-sm text-boudoir-red underline">Read the article</p>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-boudoir-cream py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl text-boudoir-ink">Have a question that is not here?</h2>
      <p class="mt-4 text-boudoir-muted">
        Ask me. There is no such thing as a silly question about this.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/contact-boudoir-photography-auckland/"
          class="inline-block bg-boudoir-red px-6 py-3 text-boudoir-white hover:opacity-90"
        >
          Get in touch
        </a>
        <a
          href="/faqs/"
          class="inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-ink hover:bg-boudoir-pink"
        >
          Read the FAQs
        </a>
      </div>
    </div>
  </section>
</Base>
