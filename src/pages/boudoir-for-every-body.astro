---
import Base from "../layouts/Base.astro";

// Drafted 2026-10-01 from Belinda's own words in chat that day: she has
// photographed women with burn scars, women before a mastectomy for breast
// cancer, women after bariatric (weight loss) surgery, and women of every
// size, colour and nationality. Ages come from the FAQs page.
// Target searches: "plus size boudoir auckland", "boudoir before mastectomy nz",
// "boudoir photography scars", "boudoir after weight loss surgery".
//
// NOTHING here is a client story or a quote. Do not add one unless a real
// client has said it and agreed to it being used.
//
// PHOTOS: Belinda's real boudoir work, already published elsewhere on this
// site. None of these women are described as having scars, surgery or any
// particular history, and no alt text says so. Never caption a photo on this
// page with a medical or body detail unless that woman has agreed to it.

const heroImage = "/images/testimonials/curvy-black-lace-studio.jpg";

const sections = [
  {
    h: "Plus size boudoir photography",
    p: [
      "Hell yes. I photograph women of every size and every shape, and curves are not something to hide or pose around. The way I light and pose you is built around your body, not somebody else's.",
      "You do not need to lose weight first. You do not need to wait for a better version of yourself to turn up. Come as you are today.",
    ],
  },
  {
    h: "Boudoir before a mastectomy",
    p: [
      "I have photographed women in the weeks before a mastectomy for breast cancer, so they have something of themselves from before.",
      "If that is why you are here, you are in careful hands. We go at your pace, and you decide what is in the photos and what is not. If your surgery date is close, get in touch as soon as you know it and I will tell you straight whether we can fit a session in before it.",
    ],
  },
  {
    h: "Boudoir with burn scars and surgical scars",
    p: [
      "I have photographed women with burn scars and with surgical scars, and I know how to light them.",
      "Some women want their scars in the frame, because they are part of their story. Some would rather they sat in shadow. Both are fine. Tell me beforehand what you would like brought forward and what you would rather keep out of frame, and that is exactly what I will do.",
    ],
  },
  {
    h: "Boudoir after weight loss surgery",
    p: [
      "I have photographed women after bariatric surgery. A body that has changed a lot deserves to be photographed as it is now, not as it was, and not as you think it should be.",
      "As with everything else, you are in charge of what we show. We talk it through before the camera comes out, so there are no surprises on the day.",
    ],
  },
  {
    h: "Every age, every colour, every background",
    p: [
      "I have photographed women in their twenties discovering their confidence, women in their forties reclaiming it, and women in their sixties celebrating it.",
      "Women of every colour, culture and nationality have been in front of my camera. Boudoir is not about looking a certain way. It is about how you feel in your own skin, right now.",
    ],
  },
];

const comfort = [
  ["Just you and me", "I am a female photographer and I work alone. There is no assistant and nobody else in the room, unless you bring a friend for support."],
  ["One woman a day", "Nobody is watching a clock. We talk first, do some practice poses, and only start when you are ready."],
  ["Nothing to explain", "You do not owe me the story of your body. Tell me only what you want me to know, and anything that is sore or tender, so I can pose you comfortably."],
  ["Your photos stay yours", "Nothing is shared anywhere without your permission. Once your final images are delivered, I delete my copies."],
  ["You can stop or change your mind", "About an outfit, a pose, or anything else, at any point."],
];

const faqs = [
  {
    q: "Can I do a boudoir shoot if I am plus size?",
    a: "Yes. I photograph women of every size and shape, and I pose and light you for your body. You do not need to change anything about yourself first.",
  },
  {
    q: "Can you keep my scars out of the photos?",
    a: "Yes, if that is what you want. Tell me beforehand what you would like brought forward and what you would rather keep out of frame, and that is exactly what I will do. Some women choose to show their scars, and that is fine too.",
  },
  {
    q: "How soon before a mastectomy should I book a boudoir shoot?",
    a: "As soon as you know your surgery date. Get in touch, tell me the date, and I will tell you straight whether we can fit a session in before it.",
  },
  {
    q: "Do I have to tell you about my surgery or my body?",
    a: "Only what you want to. It helps me to know what you would like in the photos, and anything that is sore or tender, so I can pose you comfortably. You never have to explain or justify your body.",
  },
];

const photos = [
  { src: "/images/gallery/curvy-soft-light.jpg", pos: "50% 22%", alt: "Curvy boudoir portrait in soft natural light" },
  { src: "/images/testimonials/curvy-blue-shirt-window-light.jpg", pos: "50% 25%", alt: "Boudoir portrait in an oversized blue shirt in window light" },
  { src: "/images/gallery/silhouette-dramatic.jpg", pos: "50% 40%", alt: "Dramatic boudoir silhouette in low light" },
  { src: "/images/gallery/bodyscape.jpg", pos: "50% 50%", alt: "Black and white boudoir bodyscape" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const link = "text-boudoir-red underline";
---

<Base
  title="Boudoir for Every Body | Scars, Surgery & Plus Size | Auckland"
  description="Boudoir photography in Auckland for every body. Belinda Dunne has photographed women with burn scars, before a mastectomy, after weight loss surgery, and of every size and age."
  image={heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section class="relative">
    <img
      src={heroImage}
      alt=""
      class="h-[300px] w-full object-cover opacity-50 sm:h-[340px]"
      style="object-position: 50% 22%;"
    />
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">
      <h1 class="text-4xl text-boudoir-ink md:text-5xl">Boudoir for Every Body</h1>
      <p class="text-2xl text-boudoir-pink">Every size, every age, every story.</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-boudoir-ink py-20 text-center text-boudoir-white">
    <div class="mx-auto max-w-2xl px-6">
      <h2 class="text-3xl">There is no boudoir body type</h2>
      <p class="mt-6 leading-relaxed">
        I have photographed women of every size, shape, age and colour, and
        plenty whose bodies have been through a great deal. You do not need to
        change anything about yourself first.
      </p>
      <p class="mt-4 leading-relaxed text-white/85">
        And you will never have to explain your body to me.
        <span class="text-boudoir-pink">Nothing about it needs apologising for.</span>
      </p>
    </div>
  </section>

  <!-- The situations -->
  <div class="mx-auto max-w-3xl space-y-14 px-6 py-20">
    {sections.slice(0, 3).map((s) => (
      <section>
        <h2 class="text-2xl text-boudoir-ink">{s.h}</h2>
        <div class="mt-4 space-y-3 leading-relaxed text-boudoir-muted">
          {s.p.map((para) => <p>{para}</p>)}
        </div>
      </section>
    ))}
  </div>

  <!-- Photo strip -->
  <section class="grid grid-cols-2 gap-1 md:grid-cols-4" aria-label="Examples of boudoir portraits">
    {photos.map((p) => (
      <img
        src={p.src}
        alt={p.alt}
        loading="lazy"
        class="h-64 w-full object-cover md:h-80"
        style={`object-position: ${p.pos}`}
      />
    ))}
  </section>

  <div class="mx-auto max-w-3xl space-y-14 px-6 py-20">
    {sections.slice(3).map((s) => (
      <section>
        <h2 class="text-2xl text-boudoir-ink">{s.h}</h2>
        <div class="mt-4 space-y-3 leading-relaxed text-boudoir-muted">
          {s.p.map((para) => <p>{para}</p>)}
        </div>
      </section>
    ))}
  </div>

  <!-- How the session is made comfortable -->
  <section class="bg-boudoir-cream py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-3xl text-boudoir-ink">How I make it feel safe</h2>
      <ul class="mt-8 space-y-4">
        {comfort.map(([label, why]) => (
          <li class="border-l-2 border-boudoir-pink pl-4">
            <span class="block font-semibold text-boudoir-ink">{label}</span>
            <span class="mt-1 block text-sm leading-relaxed text-boudoir-muted">{why}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-sm text-boudoir-muted">
        If you have never done anything like this before, read
        <a href="/blog/first-boudoir-shoot-what-to-expect/" class={link}>what to expect at your first boudoir shoot</a>,
        or see what other women said on the
        <a href="/testimonials/" class={link}>reviews page</a>.
      </p>
    </div>
  </section>

  <!-- FAQs -->
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h2 class="text-3xl text-boudoir-ink">Quick answers</h2>
    <div class="mt-6 divide-y divide-boudoir-cream">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-boudoir-ink">
            <span>{f.q}</span>
            <span class="shrink-0 text-xl text-boudoir-pink transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-4 text-sm leading-relaxed text-boudoir-muted">{f.a}</p>
        </details>
      ))}
    </div>
    <p class="mt-6 text-sm text-boudoir-muted">
      More on the <a href="/faqs/" class={link}>questions and answers page</a>.
    </p>
  </section>

  <!-- CTA -->
  <section class="bg-boudoir-ink py-20 text-center text-boudoir-white">
    <div class="mx-auto max-w-2xl px-6">
      <h2 class="text-3xl text-boudoir-pink">Tell me what you are hoping for</h2>
      <p class="mt-6 leading-relaxed">
        Send me a message and share as much or as little as you like. There is
        no pressure, and I will come back to you with a proper reply.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/contact-boudoir-photography-auckland/"
          class="inline-block bg-boudoir-red px-6 py-3 text-boudoir-white hover:opacity-90"
        >
          Get in touch
        </a>
        <a
          href="/pricing/"
          class="inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink"
        >
          See pricing
        </a>
      </div>
    </div>
  </section>
</Base>
