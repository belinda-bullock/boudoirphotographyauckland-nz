---
import Base from "../layouts/Base.astro";

// Gift voucher page. The voucher offer already existed in two places: a block
// on the pricing page and one FAQ answer. Neither of them can be found by
// somebody searching for a gift, which is how most voucher buyers arrive.
// Nothing here is new policy. Every line is Belinda's own approved wording from
// the pricing page and the FAQs, reorganised for a person who is shopping for
// a present and does not want to read a pricing page to find it.
//
// Deliberately NOT dated to one season. Christmas is the biggest window, but a
// page that says "Christmas 2026" is wrong for ten months of the year.

const steps = [
  {
    title: "We talk first",
    body: "Get in touch and tell me about her. We work out together what kind of shoot suits her and which package fits. You do not have to know any of that before you message me.",
  },
  {
    title: "You get a voucher to give her",
    body: "A digital certificate you can hand over on the day. It says that somebody who loves her has given her the gift of a boudoir shoot, and it sets out how long her session is and how many images she gets. It does not show the price. She never sees what you spent.",
  },
  {
    title: "Then she talks to me herself",
    body: "When she is ready she gives me a call, and that conversation is hers. We go through the photos she wants, what to bring, and exactly how the day runs. Knowing what happens is what settles the nerves.",
  },
  {
    title: "Three months to use it",
    body: "That is on purpose. Left open ended, a lot of women put it off, usually waiting until they have lost weight or until some better version of themselves turns up. She does not need to be any different to do this. Three months is a gentle push to take the time for herself.",
  },
];

const occasions = [
  ["Christmas", "The big one. Order early. December fills up and you want the voucher in your hands well before you need to wrap it."],
  ["A milestone birthday", "A 30th, 40th or 50th. Friends club together for this one more often than you would think."],
  ["Valentine's Day", "Usually a partner, and usually somebody who has heard her say she would never do it. She would."],
  ["Mother's Day", "For a woman who has spent years being photographed by nobody, holding the camera for everyone else."],
  ["An anniversary, or no occasion at all", "A gift for no reason is a perfectly good reason."],
];

const photoBreak = [
  { src: "/images/home/gloves.jpg", pos: "50% 25%", alt: "Elegant boudoir portrait wearing long gloves" },
  { src: "/images/gallery/glamour-studio.jpg", pos: "50% 20%", alt: "Glamour studio boudoir portrait" },
  { src: "/images/home/spotlight-stool.jpg", pos: "50% 30%", alt: "Boudoir portrait seated under a spotlight" },
  { src: "/images/gallery/soft-colour-eye-contact.jpg", pos: "50% 20%", alt: "Soft colour boudoir portrait with direct eye contact" },
];
---

<Base
  title="Boudoir Gift Voucher Auckland | A Gift She Will Not Buy Herself"
  description="Buy a boudoir photography gift voucher in Auckland. A digital certificate that never shows the price, a private conversation just for her, and three months to use it."
  image="/images/home/gloves.jpg"
>
  <section class="mx-auto max-w-3xl px-6 pt-16 text-center">
    <h1 class="text-4xl text-boudoir-ink md:text-5xl">Boudoir Gift Vouchers</h1>
    <p class="mt-6 text-boudoir-muted">
      The gift she would never buy for herself, from somebody who thinks she
      should.
    </p>
    <p class="mt-4 text-boudoir-muted">
      Gift vouchers are one of the most common ways sessions get booked. Friends
      buy them for a friend's milestone birthday. Husbands buy them for their
      wives. Nobody who has been given one has regretted it.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <h2 class="text-3xl text-boudoir-ink">How it works</h2>
    <div class="mt-10 space-y-8">
      {steps.map((s) => (
        <div class="border-l-2 border-boudoir-pink pl-6">
          <h3 class="text-lg text-boudoir-ink">{s.title}</h3>
          <p class="mt-2 leading-relaxed text-boudoir-muted">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="grid grid-cols-2 gap-1 md:grid-cols-4">
    {photoBreak.map((p) => (
      <img
        src={p.src}
        alt={p.alt}
        loading="lazy"
        class="h-64 w-full object-cover md:h-80"
        style={`object-position: ${p.pos}`}
      />
    ))}
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20">
    <h2 class="text-3xl text-boudoir-ink">When people buy them</h2>
    <ul class="mt-8 space-y-4">
      {occasions.map(([label, why]) => (
        <li class="border-l-2 border-boudoir-pink pl-4">
          <span class="block font-semibold text-boudoir-ink">{label}</span>
          <span class="mt-1 block text-sm leading-relaxed text-boudoir-muted">{why}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-boudoir-ink py-20 text-boudoir-white">
    <div class="mx-auto max-w-2xl px-6">
      <h2 class="text-3xl text-boudoir-pink">If you are worried she will say no</h2>
      <p class="mt-6 leading-relaxed">
        Most women say that first. Then they call me, and we talk, and by the end
        of the call they are picking outfits. The nerves are not about whether
        she wants to. They are about not knowing how it works.
      </p>
      <p class="mt-4 leading-relaxed">
        That is what the conversation is for, and it happens before she commits
        to anything. She can ask me anything she likes, and she is not talking to
        a booking form. She is talking to me.
      </p>
      <p class="mt-4 leading-relaxed">
        She can bring a support person. Nothing goes online unless she says it
        can. Not the website, not Instagram, not anywhere.
      </p>
    </div>
  </section>

  <section class="bg-boudoir-cream py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl text-boudoir-ink">Buy her a voucher</h2>
      <p class="mt-4 text-boudoir-muted">
        Send me a message and tell me a bit about her. I will come back to you
        with what suits, and the voucher is a digital certificate, so there is
        nothing to wait on in the post.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/contact-boudoir-photography-auckland/"
          class="inline-block bg-boudoir-red px-6 py-3 text-boudoir-white hover:bg-boudoir-red-hover"
        >
          Ask about a voucher
        </a>
        <a
          href="/pricing/"
          class="inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-ink hover:bg-boudoir-pink"
        >
          See the packages
        </a>
      </div>
      <p class="mt-8 text-sm text-boudoir-muted">
        If it is for a milestone, there is more on the
        <a href="/milestone-birthday-boudoir/" class="text-boudoir-red underline">birthday boudoir page</a>.
        If she wants to know what she would wear, send her the
        <a href="/what-to-wear-boudoir-shoot/" class="text-boudoir-red underline">wardrobe guide</a>,
        and what other women said is on the
        <a href="/testimonials/" class="text-boudoir-red underline">reviews page</a>.
      </p>
    </div>
  </section>
</Base>
