---
import Base from "../layouts/Base.astro";

const FORM_ACTION = "https://api.web3forms.com/submit";
const WEB3FORMS_KEY = "ff781121-c927-40fe-89a9-f7798a2a0838";
---

<Base
  title="Contact | Boudoir Photography Auckland"
  description="Contact Belinda Dunne, female boudoir photographer on Auckland's Hibiscus Coast. Book a free, no obligation chat or call 027 432 6504."
>
  <section class="bg-[#201520] py-20 text-boudoir-white">
    <div class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-2">
      <div>
        <h1 class="text-5xl">Contact me</h1>
        <p class="mt-8">
          Call Belinda on
          <br />
          <a href="tel:+64274326504" class="underline">0274326504</a>
        </p>
        <div class="mt-10 space-y-4 text-sm text-white/95">
          <p>
            Getting in touch does not commit you to anything. Ask me whatever
            you need to before you decide.
          </p>
          <p>
            Every session is just the two of us, no assistant and no one else
            in the room. Your images are never shared anywhere without your
            permission, and I delete my copies once yours are delivered.
          </p>
          <p>
            <a href="/faqs/" class="text-boudoir-pink underline">Read the full FAQs</a>
            before you write, if you would rather.
          </p>
        </div>
      </div>
      <form action={FORM_ACTION} method="POST" class="space-y-4">
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input type="hidden" name="redirect" value="https://www.boudoirphotographyauckland.co.nz/contact-thanks/" />
        <input type="hidden" name="subject" value="New inquiry from Boudoir Photography Auckland website" />
        <input type="hidden" name="from_name" value="Boudoir Photography Auckland Contact Form" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div>
          <p class="text-sm">Name</p>
          <div class="mt-1 grid gap-2 sm:grid-cols-2">
            <input required type="text" name="firstName" placeholder="First Name (required)" class="rounded-xl bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
            <input required type="text" name="lastName" placeholder="Last Name (required)" class="rounded-xl bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
          </div>
        </div>
        <div>
          <p class="text-sm">Phone number (required)</p>
          <input required type="tel" name="phone" pattern="(.*[0-9]){7,}.*" title="Please enter a phone number with at least 7 digits" class="mt-1 w-full rounded-xl bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
        </div>
        <div>
          <p class="text-sm">What date would you like for your shoot?</p>
          <input type="text" name="shoot_date" placeholder="e.g. a date, month, or 'flexible'" class="mt-1 w-full rounded-xl bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
        </div>
        <div>
          <p class="text-sm">Email (required)</p>
          <input required type="email" name="email" class="mt-1 w-full rounded-xl bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
        </div>
        <div>
          <p class="text-sm">How did you hear about us?</p>
          <textarea name="heardFrom" rows="2" class="mt-1 w-full rounded-xl bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink"></textarea>
        </div>
        <div>
          <label for="c-look" class="text-sm">Which look are you drawn to? (<a href="/boudoir-photoshoot-gallery-auckland/" class="text-boudoir-pink underline">see the four looks</a>)</label>
          <select id="c-look" name="look" data-look-select class="mt-1 w-full rounded-xl bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink">
            <option value="">Choose one, or leave it for now</option>
            <option value="light-and-soft">Light and soft</option>
            <option value="dark-and-dramatic">Dark and dramatic</option>
            <option value="black-and-white">Black and white</option>
            <option value="glamour-and-character">Glamour and character</option>
            <option value="a-mix">A mix of looks</option>
            <option value="not-sure">Not sure yet, help me choose</option>
          </select>
        </div>
        <div>
          <label for="c-not-on-site" class="text-sm">Looking for something you can't see on this site? Not everything I photograph can go on a public website. Tell me what you have in mind and I will let you know, privately.</label>
          <textarea id="c-not-on-site" name="not_on_site" rows="2" class="mt-1 w-full rounded-xl bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink"></textarea>
        </div>
        <div>
          <p class="text-sm">Please tell me as much as you can about the sort of images you would like and when you would like to shoot</p>
          <textarea name="message" rows="4" class="mt-1 w-full rounded-xl bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink"></textarea>
        </div>
        <button type="submit" class="btn-pill">
          Send
        </button>
      </form>
    </div>
  </section>
</Base>

<script>
  // Preselect the look when someone arrives from the gallery ("Drawn to this look? Tell me").
  const look = new URLSearchParams(window.location.search).get("look");
  if (look) {
    document.querySelectorAll<HTMLSelectElement>("select[data-look-select]").forEach((sel) => {
      if ([...sel.options].some((o) => o.value === look)) sel.value = look;
    });
  }
</script>
