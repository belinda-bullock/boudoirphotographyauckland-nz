---
import Base from "../layouts/Base.astro";

// TODO before go-live: replace FORM_ACTION with a real Formspree / Web3Forms
// endpoint so enquiries actually arrive somewhere. Currently a placeholder.
const FORM_ACTION = "https://formspree.io/f/REPLACE_ME";
---

<Base
  title="Contact | Boudoir Photography Auckland"
  description="Get in touch to book your Auckland boudoir photography session, or ask a question first. Call Belinda on 027 432 6504."
>
  <section class="bg-[#201520] py-20 text-boudoir-white">
    <div class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-2">
      <div>
        <h1 class="text-5xl">Contact me</h1>
        <p class="mt-8">
          Call Belinda on
          <br />
          <a href="tel:+64274326504" class="underline">0274326504</a>
        </p>
      </div>
      <form action={FORM_ACTION} method="POST" class="space-y-4">
        <div>
          <p class="text-sm">Name</p>
          <div class="mt-1 grid grid-cols-2 gap-2">
            <input required type="text" name="firstName" placeholder="First Name (required)" class="bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
            <input required type="text" name="lastName" placeholder="Last Name (required)" class="bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
          </div>
        </div>
        <div>
          <p class="text-sm">Phone number (required)</p>
          <input required type="tel" name="phone" class="mt-1 w-full bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
        </div>
        <div>
          <p class="text-sm">Email (required)</p>
          <input required type="email" name="email" class="mt-1 w-full bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
        </div>
        <div>
          <p class="text-sm">How did you hear about me?</p>
          <textarea name="heardFrom" rows="2" class="mt-1 w-full bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink"></textarea>
        </div>
        <div>
          <p class="text-sm">Message</p>
          <textarea name="message" rows="3" class="mt-1 w-full bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink"></textarea>
        </div>
        <button type="submit" class="border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink">
          Send
        </button>
      </form>
    </div>
  </section>
</Base>
