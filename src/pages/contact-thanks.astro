---
import Base from "../layouts/Base.astro";
---

<Base
  title="Thanks for Reaching Out | Boudoir Photography Auckland"
  description="Thank you for your enquiry. Belinda will be in touch soon."
  noindex
>
  <section class="bg-boudoir-ink py-24 text-center text-boudoir-white">
    <div class="mx-auto max-w-2xl px-6">
      <h1 class="text-5xl">
        Thank <span class="text-boudoir-pink">you.</span>
      </h1>
      <p class="mt-6 text-white/85">
        Your message has landed safely and I'm so glad you reached out. I'll
        be in touch soon to chat about your boudoir experience.
      </p>
      <p class="mt-4 text-white/85">
        In the meantime, you can call or text me on
        <a href="tel:+64274326504" class="text-boudoir-pink underline">027 432 6504</a>.
      </p>
      <a
        href="/"
        class="mt-10 inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink"
      >
        Back to Home
      </a>
    </div>
  </section>
</Base>
