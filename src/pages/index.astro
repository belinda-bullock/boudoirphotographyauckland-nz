---
import Base from "../layouts/Base.astro";

const steps = [
  {
    number: "STEP 1",
    title: "REACH OUT.",
    highlight: "Booking Your Auckland Boudoir Photography Session.",
    rest: "Reach out with a message that's as bold or bashful as you like—just make the first move. Once we connect, I'll send you everything you need to know: pricing, booking details, session prep, and what to expect.",
  },
  {
    number: "STEP 2",
    title: "HERE TO CHEER YOU ON.",
    highlight: "Your Guided Boudoir Photoshoot Experience.",
    rest: "On shoot day, we kick things off with hugs and high vibes. You'll be pampered with hair and makeup, your favourite music playing in the background, and a space where you can completely let go. I'll pose you, guide you, and cheer you on the whole way.",
  },
  {
    number: "STEP 3",
    title: "Your jaw-dropping reveal.",
    highlight: "Viewing Your Boudoir Photos.",
    rest: "After the session, you'll get to see your images—yourself—like never before. Choose what you love, whether it's a luxe album, framed art, or something special just for you. These aren't just photos—they're proof of how powerful and beautiful you truly are.",
  },
];

const packages = [
  {
    name: "Tease",
    icon: "/images/icons/lips.png",
    included: "A 1-hour boudoir shoot\n6 fully edited digital images of your choice – the magazine-worthy kind every woman deserves\nPlus 6 unedited images – because, it's a powerful reminder you are stunning without the polish",
    blurb: "Just enough to leave you breathless. Perfect for first-timers or anyone wanting a taste of the boudoir experience without going all in. A beautiful introduction to your sultry side.",
  },
  {
    name: "Temptation",
    icon: "/images/icons/fire.png",
    included: "A 2-hour boudoir shoot\n10 fully edited digital images – your most breathtaking shots, with all the polish and glow you deserve\nPlus 10 unedited images – a powerful reminder that your beauty doesn't rely on edits",
    blurb: "Let yourself go a little deeper. This experience is all about celebrating your power, beauty, and sensuality. More looks, more images, and more time to shine.",
  },
  {
    name: "Total Knockout",
    icon: "/images/icons/lingerie.png",
    included: "A 3-hour boudoir experience\n20 fully edited digital images – stunning, detailed, and crafted to celebrate you at your best\nPlus 20 unedited images – a beautiful reminder that you looked this incredible before the edits even began",
    blurb: "All eyes on you. This is the package for anyone who refuses to leave behind a single favourite look. With enough gorgeous images to create a personalised keepsake book or unforgettable gift, you'll have a collection that celebrates every side of you—now and forever.",
  },
];

const gallerySection1 = [
  { src: "/images/home/midriff-lingerie.jpg", alt: "Boudoir photo of a woman's midriff wearing sexy lingerie" },
  { src: "/images/home/lace-lingerie.jpg", alt: "Boudoir photo of a woman wearing lace lingerie" },
  { src: "/images/home/on-bed.jpg", alt: "Boudoir photo of a woman on a bed" },
  { src: "/images/home/low-light-thong.jpg", alt: "Boudoir photo of a woman in low light wearing a thong" },
];

const gallerySection2 = [
  { src: "/images/home/spotlight-stool.jpg", alt: "Boudoir photo of a woman in a one piece under a spotlight, leaning on a stool" },
  { src: "/images/home/bed-facing-away.jpg", alt: "Boudoir photo of a woman on a bed facing away from the camera in a seductive pose" },
  { src: "/images/home/gloves.jpg", alt: "Boudoir photo of a woman looking at the camera wearing gloves" },
  { src: "/images/home/sheepskin-rug.jpg", alt: "Boudoir photo of a woman lying on a sheepskin rug in lingerie" },
];
---

<Base
  title="Boudoir Photography Auckland | Elegant & Confidence-Boosting Sessions"
  description="A private boudoir photography experience in Auckland for women who want to feel confident and beautiful. Book your session with Belinda Dunne on the Hibiscus Coast."
>
  <!-- Full-bleed title hero -->
  <section class="relative">
    <img
      src="/images/home/hero.jpg"
      alt="Auckland boudoir photography"
      class="h-[630px] w-full object-cover opacity-50 sm:h-[420px]"
      style="object-position: 75.5744% 73.6184%;"
      width="1600"
      height="1065"
    />
    <div class="absolute inset-0 flex items-center justify-center px-6">
      <h1 class="max-w-3xl text-center text-5xl text-boudoir-ink sm:text-6xl">Boudoir Photography Auckland</h1>
    </div>
  </section>

  <!-- Black CTA band -->
  <section class="bg-boudoir-ink py-16 text-center text-boudoir-white">
    <div class="mx-auto max-w-2xl px-6">
      <p class="text-2xl uppercase tracking-wide">
        A private boudoir photography experience for women who want to feel confident and beautiful
      </p>
      <h2 class="mt-4 text-3xl">
        Welcome to a space that <span class="text-boudoir-pink">celebrates your body.</span>
      </h2>
      <p class="mt-6 text-white/80">
        Where you'll be guided through a confidence boosting boudoir experience
        from start to finish, so you feel relaxed, supported, and walk away
        with images that make you say, <em>damn&hellip; is that really me?</em>
      </p>
      <p class="mt-6 text-white/80">
        Every size, every shape, every age. There is no body this is not for,
        and the way I light and pose you is built around yours, not somebody
        else's.
      </p>
      <a
        href="/contact-boudoir-photography-auckland"
        class="mt-8 inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink"
      >
        Book your Auckland boudoir session
      </a>
    </div>
  </section>

  <!-- Gallery strip 1 -->
  <section class="grid grid-cols-2 sm:grid-cols-4">
    {gallerySection1.map((img) => (
      <img
        src={img.src}
        alt={img.alt}
        loading="lazy"
        class="aspect-[4/3] w-full object-cover"
      />
    ))}
  </section>

  <!-- Meet your photographer -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <img
        src="/images/home/photographer-belinda.jpg"
        alt="Belinda Dunne, Auckland boudoir photographer"
        style="object-position: 46.8% 27.2%;"
        class="aspect-square w-full max-w-[270px] shrink-0 object-cover"
        width="270"
        height="270"
      />
      <div>
        <h2 class="text-3xl">Meet your photographer</h2>
        <p class="mt-5 text-boudoir-muted">
          Hi, I'm Belinda a female boudoir photographer based in Auckland. I
          only take on one session a day so I'm never watching the clock. My
          master's in photography focused specifically on posing and
          lighting, the two things that make or break how a boudoir photo
          turns out.
        </p>
        <a href="/about-belinda-dunne" class="mt-2 inline-block text-boudoir-pink underline">
          More about Belinda
        </a>
      </div>
    </div>
  </section>

  <!-- Privacy and comfort. Wording lifted from Belinda's own FAQ answers, not
       invented: the same three promises, surfaced where the decision is made
       instead of only on /faqs where most visitors never go. -->
  <section class="bg-boudoir-cream py-20">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <h2 class="text-3xl text-boudoir-ink">Your session stays yours</h2>
      <p class="mx-auto mt-5 max-w-2xl text-boudoir-muted">
        The things most women want to ask before they get in touch, answered plainly.
      </p>
      <div class="mt-12 grid gap-10 text-left sm:grid-cols-3">
        <div>
          <h3 class="text-xl text-boudoir-pink">Just you and me</h3>
          <p class="mt-3 text-boudoir-muted">
            Every session is the two of us. No assistant, no one else in the
            room. I shoot everything myself.
          </p>
        </div>
        <div>
          <h3 class="text-xl text-boudoir-pink">Nothing shared without your say so</h3>
          <p class="mt-3 text-boudoir-muted">
            Your images are never posted or shown anywhere unless you tell me
            it is okay. Your session, your body, your call.
          </p>
        </div>
        <div>
          <h3 class="text-xl text-boudoir-pink">I delete my copies</h3>
          <p class="mt-3 text-boudoir-muted">
            Once your final images are delivered, I delete mine. Keep a few
            backups of your own, because I will not have them.
          </p>
        </div>
      </div>
      <a href="/faqs" class="mt-10 inline-block text-boudoir-pink underline">
        Read all the questions and answers
      </a>
    </div>
  </section>

  <!-- Steps -->
  <section class="bg-boudoir-ink py-20 text-boudoir-white">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <h2 class="text-3xl">
        <span class="text-boudoir-pink">Your Boudoir Experience,</span> Step by Step
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-white/80">
        A personalised, confidence-boosting experience from the first message
        to the moment you see your stunning images.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl grid-cols-1 px-6 sm:grid-cols-3 md:px-12 lg:px-20">
      <div class="relative">
        <img
          src="/images/home/bw-bed.jpg"
          alt="Black and white boudoir photo of a woman on a bed"
          class="h-[280px] w-full object-cover sm:h-[340px]"
        />
      </div>
      <div class="flex flex-col items-center justify-center bg-[#201520] px-8 py-10 text-center">
        <p class="text-boudoir-pink">
          <span class="font-semibold uppercase tracking-wide">{steps[0].number}</span>
          <br />
          <span class="font-semibold uppercase tracking-wide">{steps[0].title}</span>
        </p>
        <p class="mt-4 text-sm">
          <span class="text-boudoir-pink">{steps[0].highlight}</span>{" "}
          <span class="text-white/85">{steps[0].rest}</span>
        </p>
      </div>
      <div class="relative">
        <img
          src="/images/home/bw-portrait.jpg"
          alt="Black and white boudoir portrait of a young woman"
          class="h-[280px] w-full object-cover sm:h-[340px]"
        />
      </div>

      <div class="flex flex-col items-center justify-center bg-[#201520] px-8 py-10 text-center">
        <p class="text-boudoir-pink">
          <span class="font-semibold uppercase tracking-wide">{steps[1].number}</span>
          <br />
          <span class="font-semibold uppercase tracking-wide">{steps[1].title}</span>
        </p>
        <p class="mt-4 text-sm">
          <span class="text-boudoir-pink">{steps[1].highlight}</span>{" "}
          <span class="text-white/85">{steps[1].rest}</span>
        </p>
      </div>
      <div class="relative">
        <img
          src="/images/home/bw-tiled.jpg"
          alt="Black and white boudoir photo of a young woman lying on a tiled surface"
          class="h-[280px] w-full object-cover sm:h-[380px]"
        />
      </div>
      <div class="flex flex-col items-center justify-center bg-[#201520] px-8 py-10 text-center">
        <p class="text-boudoir-pink">
          <span class="font-semibold uppercase tracking-wide">{steps[2].number}</span>
          <br />
          <span class="font-semibold">{steps[2].title}</span>
        </p>
        <p class="mt-4 text-sm">
          <span class="text-boudoir-pink">{steps[2].highlight}</span>{" "}
          <span class="text-white/85">{steps[2].rest}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery strip 2 -->
  <section class="grid grid-cols-2 sm:grid-cols-4">
    {gallerySection2.map((img) => (
      <img
        src={img.src}
        alt={img.alt}
        loading="lazy"
        class="aspect-[4/3] w-full object-cover"
      />
    ))}
  </section>

  <!-- Pricing teaser -->
  <section class="bg-boudoir-ink py-20 text-boudoir-white">
    <div class="mx-auto max-w-6xl px-6 md:px-12 lg:px-20">
      <div class="max-w-2xl text-center md:mx-auto">
        <h2 class="text-3xl text-boudoir-pink">Invest in Yourself</h2>
        <p class="mt-3 text-white/85">This is more than a photoshoot - this is a celebration of you.</p>
        <a href="/pricing" class="mt-2 inline-block text-white/85 underline">View our packages</a>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {packages.map((pkg) => (
          <div class="bg-[#201520] px-8 py-10 text-center">
            <img src={pkg.icon} alt="" class="mx-auto h-12 w-12" />
            <h3 class="mt-4 text-2xl uppercase tracking-wide text-boudoir-pink">{pkg.name}</h3>
            <div class="mt-5 space-y-3 text-sm text-white/90">
              {pkg.included.split("\n").map((line) => <p>{line}</p>)}
            </div>
            <hr class="mx-auto mt-6 w-16 border-white/30" />
            <p class="mt-6 text-sm text-white/80">{pkg.blurb}</p>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <a
          href="/pricing"
          class="inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink"
        >
          View Pricing
        </a>
      </div>
    </div>
  </section>

  <!-- Closing CTA (full-bleed photo background) -->
  <section class="relative">
    <img
      src="/images/home/low-light-innocent.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="relative mx-auto max-w-3xl px-6 py-24 text-center text-boudoir-white">
      <h2 class="text-3xl">
        Ready <span class="text-boudoir-pink">to fall in love with yourself?</span>
      </h2>
      <p class="mt-6 text-white/90">
        If you would like a FREE no obligation consultation, I'd love you to contact me:
      </p>
      <a
        href="/contact-boudoir-photography-auckland"
        class="mt-8 inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink"
      >
        Contact me today
      </a>

      <hr class="mx-auto mt-16 w-16 border-white/30" />

      <p class="mt-10 text-white/90">
        And whilst you're at it, feel free to join the ladies only private
        boudoir Facebook group where you'll see other Boudoir photos and join
        a group of like minded ladies.
      </p>
      <a
        href="https://www.facebook.com/groups/"
        class="mt-6 inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink"
      >
        Join the facebook private group
      </a>

      <hr class="mx-auto mt-16 w-16 border-white/30" />

      <h2 class="mt-10 text-3xl text-boudoir-pink">
        You Are Bold.<br />Beautiful.<br />Unforgettable.
      </h2>
    </div>
  </section>

  <!-- Testimonial (full-bleed photo background, naturally dark) -->
  <section class="relative">
    <img
      src="/images/home/tiled-floor-face-down.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="relative mx-auto max-w-3xl px-6 py-20 text-center text-boudoir-white">
      <blockquote>
        &ldquo;For those of you who don't know Belinda, she is not just an
        incredible and talented photographer she is one of the kindest people
        I know. What you can expect is to be guided in a very relaxed
        environment to get images that are beyond what you thought was
        possible. I can not recommend her enough.&rdquo;
      </blockquote>
      <p class="mt-6">Kendal</p>
      <a href="/testimonials" class="mt-6 inline-block text-boudoir-pink underline">
        Read what other women said
      </a>
    </div>
  </section>

  <!-- Contact -->
  <section class="bg-[#201520] py-20 text-boudoir-white">
    <div class="mx-auto grid max-w-5xl gap-10 px-6 md:grid-cols-2">
      <div>
        <h2 class="text-5xl">Contact me</h2>
        <p class="mt-8">
          Call Belinda on
          <br />
          <a href="tel:+64274326504" class="underline">0274326504</a>
        </p>
      </div>
      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
        <input type="hidden" name="access_key" value="ff781121-c927-40fe-89a9-f7798a2a0838" />
        <input type="hidden" name="redirect" value="https://www.boudoirphotographyauckland.co.nz/contact-thanks" />
        <input type="hidden" name="subject" value="New inquiry from Boudoir Photography Auckland website" />
        <input type="hidden" name="from_name" value="Boudoir Photography Auckland Contact Form" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div>
          <p class="text-sm">Name</p>
          <div class="mt-1 grid grid-cols-2 gap-2">
            <input required type="text" name="firstName" placeholder="First Name (required)" class="bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
            <input required type="text" name="lastName" placeholder="Last Name (required)" class="bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
          </div>
        </div>
        <div>
          <p class="text-sm">Phone number (required)</p>
          <input required type="tel" name="phone" pattern="(.*[0-9]){7,}.*" title="Please enter a phone number with at least 7 digits" class="mt-1 w-full bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
        </div>
        <div>
          <p class="text-sm">What date would you like for your shoot?</p>
          <input type="text" name="shoot_date" placeholder="e.g. a date, month, or 'flexible'" class="mt-1 w-full bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
        </div>
        <div>
          <p class="text-sm">Email (required)</p>
          <input required type="email" name="email" class="mt-1 w-full bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink" />
        </div>
        <div>
          <p class="text-sm">How did you hear about us?</p>
          <textarea name="heardFrom" rows="2" class="mt-1 w-full bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink"></textarea>
        </div>
        <div>
          <p class="text-sm">Please tell me as much as you can about the sort of images you would like and when you would like to shoot</p>
          <textarea name="message" rows="4" class="mt-1 w-full bg-[#FAFAFA] px-3 py-2 text-sm text-boudoir-ink"></textarea>
        </div>
        <button type="submit" class="border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink">
          Send
        </button>
      </form>
    </div>
  </section>
</Base>
