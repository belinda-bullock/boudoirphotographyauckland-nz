---
import Base from "../layouts/Base.astro";

const steps = [
  {
    number: "1",
    title: "REACH OUT",
    body: "Reach out with message that's as open or curious as you like, just make that first move. Once we connect, I'll make sure you feel completely prepared, comfortable, and excited about your shoot, from our first conversation to the final beautiful images.",
  },
  {
    number: "2",
    title: "HERE TO SUPPORT YOU ON YOUR JOURNEY.",
    body: "On shoot day, we start by clarifying what kind of photos will make you feel cherished, radiant, and empowered. We'll go through your outfit choices, discuss comfortable poses, and finalise the vision that will give you the maternity photos you've always dreamed of. I'll gently guide you, making sure you feel relaxed and celebrated, leaving you proud of the beautiful memories we've created.",
  },
  {
    number: "3",
    title: "YOUR CHERISHED REVEAL.",
    body: "After the session, you'll choose your favourite images, and I'll lovingly enhance them with careful editing. Each package includes unedited photos too, so you have both the wow of polish and the heartfelt reminder that your journey is truly stunning.",
  },
];

const maternityImages = [
  { src: "/images/maternity/belly.jpg", alt: "Maternity belly portrait" },
  { src: "/images/maternity/dress.jpg", alt: "Maternity portrait in a flowing dress" },
  { src: "/images/maternity/image.jpg", alt: "Elegant maternity portrait" },
  { src: "/images/maternity/photo.jpg", alt: "Maternity photography session" },
];
---

<Base
  title="Maternity Photography Auckland | Elegant Pregnancy Portraits"
  description="Elegant maternity photography in Auckland. A supportive, guided session that celebrates your pregnancy journey."
>
  <!-- Hero: full-bleed photo with dark overlay -->
  <section class="relative">
    <img
      src="/images/maternity/hero.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-24 text-center">
      <h1 class="text-4xl md:text-5xl">Maternity Photography</h1>
      <p class="mt-4 text-lg">Elegant Maternity photography in Auckland.</p>
    </div>
  </section>

  <!-- Intro: plain centered text -->
  <section class="mx-auto max-w-2xl px-6 py-20 text-center">
    <p class="text-boudoir-muted">
      Welcome to a space that celebrates your pregnancy and the incredible
      journey you are on.
    </p>
    <p class="mt-4 text-boudoir-muted">
      Pregnancy is a magical time. Your body is doing something incredible
      and this is a moment worth capturing so you can remember it forever.
      I'll guide you through the shoot so you feel comfortable and
      confident. By the end, you'll have images that make you smile, laugh
      and maybe even shed a happy tear. Your journey will be beautifully
      documented.
    </p>
    <a
      href="/contact-boudoir-photography-auckland"
      class="mt-8 inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink"
    >
      Contact me today
    </a>
  </section>

  <!-- Gallery grid -->
  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-4">
      {maternityImages.map((img) => (
        <img
          src={img.src}
          alt={img.alt}
          loading="lazy"
          class="aspect-[3/4] w-full object-cover"
        />
      ))}
    </div>
  </section>

  <!-- Steps: checkerboard grid, same pattern as the homepage -->
  <section class="bg-boudoir-ink py-20 text-boudoir-white">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <h2 class="text-3xl md:text-4xl">Your Maternity shoot, Step by Step</h2>
      <p class="mx-auto mt-6 max-w-2xl text-white/80">
        A personalised, supportive experience from the first message to the
        moment you see your stunning images.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl grid-cols-1 sm:grid-cols-3">
      <img
        src="/images/maternity/photos-1.jpg"
        alt="Maternity photography session"
        class="h-[280px] w-full object-cover sm:h-[340px]"
      />
      <div class="flex flex-col items-center justify-center px-8 py-10 text-center">
        <p class="text-boudoir-pink">
          <span class="font-semibold">{steps[0].number}</span>
          <br />
          <span class="font-semibold uppercase tracking-wide">{steps[0].title}</span>
        </p>
        <p class="mt-4 text-sm text-white/85">{steps[0].body}</p>
      </div>
      <img
        src="/images/maternity/photos-2.jpg"
        alt="Maternity photography session"
        class="h-[280px] w-full object-cover sm:h-[340px]"
      />

      <div class="flex flex-col items-center justify-center px-8 py-10 text-center">
        <p class="text-boudoir-pink">
          <span class="font-semibold">{steps[1].number}</span>
          <br />
          <span class="font-semibold uppercase tracking-wide">{steps[1].title}</span>
        </p>
        <p class="mt-4 text-sm text-white/85">{steps[1].body}</p>
      </div>
      <img
        src="/images/maternity/studio.jpg"
        alt="Maternity shoot photographed in studio"
        class="h-[280px] w-full object-cover sm:h-[380px]"
      />
      <div class="flex flex-col items-center justify-center px-8 py-10 text-center">
        <p class="text-boudoir-pink">
          <span class="font-semibold">{steps[2].number}</span>
          <br />
          <span class="font-semibold uppercase tracking-wide">{steps[2].title}</span>
        </p>
        <p class="mt-4 text-sm text-white/85">{steps[2].body}</p>
      </div>
    </div>
  </section>
</Base>
