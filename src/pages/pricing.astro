---
import Base from "../layouts/Base.astro";

const packages = [
  {
    name: "Tease",
    price: "$750",
    icon: "/images/icons/lips.png",
    confirms: "Confirms your 1.5 hour boudoir photoshoot with me at my Auckland based studio, where we will create beautiful images for you to choose from.",
    included: [
      "Photo reveal session where you choose the photo you love",
      "Six fully edited, high resolution image of your choice delivered via digital download.",
      "Additional edited images can be purchased for $80 per photo but there is no pressure to buy.",
      "Hair & Makeup can be arranged by me for an additional $220 with enough notice.",
      "Ask me about wall art",
    ],
  },
  {
    name: "Temptation",
    price: "$950",
    icon: "/images/icons/fire.png",
    confirms: "Confirms your 2.5 hour boudoir photoshoot with me at my Auckland based studio, where we will create beautiful images for you to choose from.",
    included: [
      "Photo reveal session where you choose the photo's you love",
      "Ten fully edited, high resolution image of your choice delivered via digital download.",
      "Additional edited images can be purchased for $80 per photo but there is no pressure to buy.",
      "Hair & Makeup can be arranged by me for an additional $220 with enough notice.",
      "Ask me about wall art",
    ],
  },
  {
    name: "Total Knockout",
    price: "$1,200",
    icon: "/images/icons/lingerie.png",
    confirms: "Confirms your unlimited time boudoir photoshoot with me at my Auckland based studio, where we will create beautiful images for you to choose from.",
    included: [
      "Photo reveal session where you choose the photo you love",
      "Twenty fully edited, high resolution image of your choice delivered via digital download.",
      "Additional edited images can be purchased for $80 per photo but there is no pressure to buy.",
      "Hair & Makeup can be arranged by me for an additional $220 with enough notice.",
      "Ask me about wall art",
    ],
  },
];
---

<Base
  title="Boudoir Photography Pricing | Auckland Sessions from $750"
  description="Boudoir photography packages in Auckland from $750, including edited and unedited digital images with every session. No hidden costs."
>
  <!-- Hero: full-bleed photo -->
  <section class="relative">
    <img
      src="/images/pricing/hero.jpg"
      alt=""
      class="h-[380px] w-full object-cover sm:h-[420px]"
    />
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">
      <h1 class="text-4xl text-boudoir-ink md:text-5xl">Boudoir Pricing</h1>
      <p class="text-boudoir-ink">
        This is more than a photoshoot -{" "}
        <span class="text-boudoir-pink">this is a celebration of you.</span>
      </p>
    </div>
  </section>

  <!-- Intro -->
  <section class="mx-auto max-w-3xl px-6 py-16 text-center">
    <h2 class="text-3xl text-boudoir-ink">
      Boudoir shoots are about <span class="text-boudoir-pink">feeling Beautiful &amp; Empowered.</span>
    </h2>
    <p class="mt-4 text-boudoir-muted">
      In this crazy world its so easy to forget how beautiful you are. The
      pressures on our time and energy mean we don't look after ourselves as
      well as we could and often feel less amazing than we are.
    </p>
    <p class="mt-4 text-boudoir-muted">
      Boudoir photography is intimate images to remind you of everything you
      should celebrate about yourself. Wear what you like, jeans and a
      singlet, lingerie or nothing at all, and create pictures that make you
      smile and say &ldquo;hello beautiful&rdquo; every time you look at
      them.
    </p>
  </section>

  <!-- Pricing cards -->
  <section class="bg-boudoir-ink py-20 text-boudoir-white">
    <div class="mx-auto max-w-6xl px-6 md:px-12 lg:px-20">
      <div class="text-center">
        <h2 class="text-3xl text-boudoir-pink">Invest in Yourself</h2>
        <p class="mt-3 text-white/85">
          Summer is the prime season for boudoir bookings, so seize the
          opportunity to reserve your session now if you crave stunning
          photographs.
        </p>
        <p class="mt-4 text-sm uppercase tracking-wide text-white/70">
          You only buy what you love - no hidden costs
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {packages.map((pkg) => (
          <div class="bg-[#201520] px-8 py-10 text-center">
            <img src={pkg.icon} alt="" class="mx-auto h-12 w-12" />
            <h3 class="mt-4 text-2xl uppercase tracking-wide text-boudoir-pink">{pkg.name}</h3>
            <p class="mt-2 text-3xl">{pkg.price}</p>
            <p class="mt-5 text-sm text-white/85">{pkg.confirms}</p>
            <ul class="mt-5 space-y-3 text-left text-sm text-white/85">
              {pkg.included.map((line) => (
                <li class="flex gap-2">
                  <span class="text-boudoir-pink">&#10003;</span>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <a
          href="/contact-boudoir-photography-auckland"
          class="inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink"
        >
          Book now
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16 text-center">
    <p class="text-boudoir-muted">
      These sessions are for women of every size, every shape and every age.
      Not sure which package suits you, or wondering what happens on the day?
      The
      <a href="/faqs" class="text-boudoir-pink underline">questions and answers page</a>
      covers what to wear, who sees your photos, and how booking works.
    </p>
  </section>

  <!-- Testimonial: full-bleed photo background -->
  <section class="relative">
    <img
      src="/images/pricing/testimonial-bg.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="relative mx-auto max-w-3xl px-6 py-20 text-center text-boudoir-ink">
      <blockquote>
        &ldquo;I have done several shoots of various styles now with Belinda
        and she is AMAZING to work with. We recently did our first boudoir
        shoot and I loved every moment of it! Belinda immediately put me at
        ease so that I was relaxed and had fun. She gave great direction but
        was also completely open to any ideas I had and tailored my shoot to
        what I was looking for as my end result, my personal style and body
        type, but also to what my idea of boudoir is. I cannot recommend
        boudoir photography enough and am absolutely thrilled with my
        photos.&rdquo;
      </blockquote>
      <p class="mt-6">Carolyn</p>
      <a href="/testimonials" class="mt-6 inline-block text-boudoir-ink underline">
        Read what other women said
      </a>
    </div>
  </section>

  <!-- Reassurance checkerboard + closing CTA -->
  <section class="bg-boudoir-ink py-20 text-boudoir-white">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <h2 class="text-3xl">
        <span class="text-boudoir-pink">Your Boudoir Experience,</span> Step by Step
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-white/80">
        A personalised, confidence-boosting experience from the first message
        to the moment you see your stunning images.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl grid-cols-1 px-6 sm:grid-cols-3 md:px-12 lg:px-20">
      <div class="relative">
        <img src="/images/pricing/reassure-1.jpg" alt="" class="h-[280px] w-full object-cover sm:h-[340px]" />
      </div>
      <div class="flex items-center justify-center bg-[#201520] px-8 py-10 text-center">
        <p class="text-lg font-semibold uppercase tracking-wide text-boudoir-pink">
          You don't need to<br />change your weight
        </p>
      </div>
      <div class="relative">
        <img src="/images/pricing/reassure-2.jpg" alt="" class="h-[280px] w-full object-cover sm:h-[340px]" />
      </div>

      <div class="flex items-center justify-center bg-[#201520] px-8 py-10 text-center">
        <p class="text-lg font-semibold uppercase tracking-wide text-boudoir-pink">
          You don't need to<br />know how to pose
        </p>
      </div>
      <div class="relative">
        <img src="/images/pricing/reassure-3.jpg" alt="" class="h-[280px] w-full object-cover sm:h-[380px]" />
      </div>
      <div class="flex items-center justify-center bg-[#201520] px-8 py-10 text-center">
        <p class="text-lg font-semibold uppercase tracking-wide text-boudoir-pink">
          You are beautiful<br />exactly as you are
        </p>
      </div>
    </div>

    <div class="mx-auto mt-16 max-w-2xl px-6 text-center">
      <h2 class="text-3xl">Let's talk about your dream photos</h2>
      <p class="mt-4 text-white/80">Book a chat today or&hellip; book the shoot, it's all up to you.</p>
      <a
        href="/contact-boudoir-photography-auckland"
        class="mt-8 inline-block border-2 border-boudoir-pink px-6 py-3 text-boudoir-pink hover:bg-boudoir-pink hover:text-boudoir-ink"
      >
        Book your shoot today
      </a>
    </div>
  </section>
</Base>
